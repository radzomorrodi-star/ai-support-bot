# ---- Copy to .env and fill in. NEVER commit .env. ----
ENVIRONMENT=dev                 # dev | test | prod
DATABASE_URL=postgresql+asyncpg://footballbot:CHANGE_ME@postgres:5432/footballbot
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379/0

# Telegram
BOT_TOKEN=                       # from @BotFather
TELEGRAM_MODE=polling            # polling | webhook
WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_SECRET_TOKEN=            # 32+ random chars, [A-Za-z0-9_-]
WEBHOOK_PATH_SECRET=             # 32+ random chars (part of URL path)

# Secrets (generate each independently; see docs/DEPLOYMENT.md)
SECRETS_KEY=                     # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
RECEIPT_HMAC_KEY=                # 32+ random bytes, hex/base64
CONFIG_SIGNING_KEY=              # 32+ random bytes, hex/base64
AUDIT_HMAC_KEY=                  # 32+ random bytes, hex/base64

# Admin
ADMIN_ALLOWLIST=                 # comma-separated Telegram IDs allowed to be admins
ADMIN_IP_ALLOWLIST=              # optional comma-separated CIDRs; empty = no IP restriction
ADMIN_SESSION_TTL_SECONDS=1800

# Odds providers (see docs/ODDS_PROVIDERS.md)
ODDS_PRIMARY_PROVIDER=mock       # the_odds_api | mock
ODDS_FALLBACK_PROVIDER=          # optional
THE_ODDS_API_KEY=
ODDS_REGIONS=eu,uk
ODDS_HTTP_TIMEOUT_SECONDS=10
ODDS_REFRESH_SECONDS=900

# Compliance gate. Leave false. Real money is NOT implemented in this build.
REAL_MONEY_ENABLED=false
DEFAULT_TIMEZONE=Asia/Tehran
